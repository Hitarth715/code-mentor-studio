# Server-side only. Never prefix these with VITE_ and never commit a real .env file.

# Option 1 - Lovable AI gateway (default). Lovable Cloud provides LOVABLE_API_KEY for you.
LOVABLE_API_KEY=

# Option 2 - any OpenAI-compatible chat-completions provider (takes priority if set).
LLM_API_KEY=
# Default: https://ai.gateway.lovable.dev/v1/chat/completions
LLM_API_URL=
# Default: google/gemini-2.5-flash
LLM_MODEL=
